{
    "name": "revoltify/tenantify",
    "description": "Single database multi-tenant solution for Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Revoltify",
            "email": "support@revoltify.net"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.2",
        "larastan/larastan": "^3.9.3",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.11|^11.0",
        "pestphp/pest": "^3.8.6 || ^4.0.0",
        "spatie/laravel-permission": "^6.25",
        "spatie/valuestore": "^1.3.3"
    },
    "autoload": {
        "psr-4": {
            "Revoltify\\Tenantify\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Revoltify\\Tenantify\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Revoltify\\Tenantify\\TenantifyServiceProvider"
            ],
            "aliases": {
                "Tenantify": "Revoltify\\Tenantify\\Facades\\Tenantify",
                "GlobalCache": "Revoltify\\Tenantify\\Facades\\GlobalCache"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "phpstan": "vendor/bin/phpstan analyse --verbose --ansi",
        "pint": "vendor/bin/pint --ansi"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
